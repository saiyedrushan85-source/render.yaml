
services:
  - type: web
    name: rushan-instagram-bot
    runtime: python
    plan: free
    buildCommand: pip install -r requirements.txt
    startCommand: gunicorn app:app
    envVars:
      - key: IG_USER_ID
        sync: false
      - key: ACCESS_TOKEN
        sync: false
      - key: APP_SECRET
        sync: false
      - key: WEBHOOK_VERIFY_TOKEN
        sync: false
      - key: API_VERSION
        value: v26.0
